      "name": "1. Users API Tests",
      "item": [
        {
          "name": "1.1 Users - POST (Create First User)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// pre-request script",
                  "const username = pm.environment.get(\"username\");",
                  "const password = pm.environment.get(\"password\");",
                  "",
                  "if (username && password) {",
                  "    const credentials = btoa(`${username}:${password}`);",
                  "    pm.request.headers.add({",
                  "        key: 'Authorization',",
                  "        value: `Basic ${credentials}`",
                  "    });",
                  "    console.log(`Added Basic Auth header for user: ${username}`);",
                  "} else {",
                  "    console.warn('Username or password not set in environment variables.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"User created successfully\", function () {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData).to.have.property('id');",
                  "  var userId = jsonData.id;",
                  "  pm.collectionVariables.set('userId', userId);",
                  "  console.log('User ID set to:', userId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"test_user_{{timestamp}}\",\n  \"email\": \"test_{{timestamp}}@example.com\",\n  \"password\": \"test_password\"\n}"
